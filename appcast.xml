        <title>Wavetype Pro</title>
        <link>https://2amlabs.github.io/wavetype/appcast.xml</link>
        <description>Updates for Wavetype Pro (direct distribution).</description>
        <language>en</language>

        <!-- New <item> blocks generated by scripts/sparkle_release.sh go here. -->

    </channel>
</rss>
